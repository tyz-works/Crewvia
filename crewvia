#!/usr/bin/env bash
set -euo pipefail

# crewvia — One-command launcher for the crewvia multi-agent system
#
# Usage:
#   ./crewvia                        # Orchestrator を tmux モードで起動
#   ./crewvia worker code typescript  # Worker を手動起動
#   ./crewvia status                 # 稼働中の mission/worker を表示

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config/crewvia.yaml"
TOKEN_FILE="${SCRIPT_DIR}/config/.taskvia-token"

# --- config から設定を読み込む ---
read_config() {
  local key="$1" default="${2:-}"
  if [[ -f "$CONFIG_FILE" ]]; then
    local val
    val=$(grep -E "^${key}:" "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/^[^:]*:[[:space:]]*//' | sed 's/[[:space:]]*#.*//' | tr -d '"' | tr -d "'")
    if [[ -n "$val" ]]; then
      echo "$val"
      return
    fi
  fi
  echo "$default"
}

# --- CLI フラグ解析（--taskvia / --no-taskvia） ---
FLAG_TASKVIA=""
FLAG_NO_TASKVIA=""
REMAINING_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --taskvia)    FLAG_TASKVIA="true" ;;
    --no-taskvia) FLAG_NO_TASKVIA="true" ;;
    *)            REMAINING_ARGS+=("$arg") ;;
  esac
done
set -- "${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}"

# --- CREWVIA_TASKVIA 決定（env > flag > config > ask） ---
if [[ -z "${CREWVIA_TASKVIA:-}" ]]; then
  if [[ "$FLAG_TASKVIA" == "true" ]]; then
    export CREWVIA_TASKVIA="enabled"
  elif [[ "$FLAG_NO_TASKVIA" == "true" ]]; then
    export CREWVIA_TASKVIA="disabled"
  else
    TASKVIA_FROM_CONFIG="$(read_config taskvia "ask")"
    export CREWVIA_TASKVIA="$TASKVIA_FROM_CONFIG"
  fi
fi

# ask モードの対話処理（crewvia 起動時に解決する）
if [[ "${CREWVIA_TASKVIA}" == "ask" ]]; then
  if [[ -e /dev/tty ]]; then
    echo ""
    echo "[crewvia] Taskvia 承認フローを使用しますか？"
    echo "          Y = 有効（WebUI でツール承認・ログ投稿）"
    echo "          n = 無効（スタンドアロンモード、承認なし）"
    printf "> [Y/n]: "
    read -r TASKVIA_CHOICE </dev/tty || TASKVIA_CHOICE=""
    case "$TASKVIA_CHOICE" in
      n|N|no|No|NO)
        export CREWVIA_TASKVIA="disabled"
        echo "[crewvia] Taskvia 連携を無効にします（スタンドアロンモード）。"
        ;;
      *)
        export CREWVIA_TASKVIA="enabled"
        echo "[crewvia] Taskvia 承認フローを有効にします。"
        ;;
    esac
  else
    # 非対話環境: enabled にフォールバック（トークン未設定なら既存の standalone 動作に委譲）
    export CREWVIA_TASKVIA="enabled"
  fi
fi

# --- Taskvia トークンを読み込む（disabled 時はスキップ） ---
if [[ "${CREWVIA_TASKVIA}" != "disabled" ]]; then
  if [[ -z "${TASKVIA_TOKEN:-}" ]] && [[ -f "$TOKEN_FILE" ]]; then
    TASKVIA_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
    export TASKVIA_TOKEN
  fi
fi

# --- Taskvia URL ---
if [[ -z "${TASKVIA_URL:-}" ]]; then
  export TASKVIA_URL="$(read_config taskvia_url "https://taskvia.vercel.app")"
fi

# --- 起動モード ---
# CREWVIA_MUX が既に env で指定されていればそれを常に優先する (config より優先)。
# 未設定の場合のみ config/crewvia.yaml の mode: を読んで CREWVIA_MUX を決める。
#
# 旧 CREWVIA_TMUX は mission 20260907-tmux-name-cleanup で CREWVIA_MUX_ENABLED に
# 改名され、現在 CREWVIA_TMUX を読むコードはこのファイル以外に存在しない死んだ
# 変数。互換読み込みはせず値も参照しない — env にあっても config 読み込みを
# ブロックしない (以前は `[[ -z "${CREWVIA_TMUX:-}" ]]` で config 読み込み自体を
# スキップしており、旧変数が残っているだけで mode: の変更が無視される事故が
# あった)。存在すれば無視される旨だけ警告する。
if [[ -n "${CREWVIA_TMUX:-}" ]]; then
  echo "[crewvia] WARNING: CREWVIA_TMUX は廃止されました（無視されます）。CREWVIA_MUX=tmux|herdr を使用してください。" >&2
fi

if [[ -z "${CREWVIA_MUX:-}" ]]; then
  MODE="$(read_config mode "tmux")"
  case "$MODE" in
    tmux)
      export CREWVIA_MUX=tmux
      ;;
    herdr)
      export CREWVIA_MUX=herdr
      ;;
    inline)
      : # CREWVIA_MUX は export しない → start.sh 側がインラインモードにフォールバックする
      ;;
    *)
      echo "[crewvia] WARNING: 不明な mode '$MODE'。tmux で起動します。" >&2
      export CREWVIA_MUX=tmux
      ;;
  esac
fi

# --- サブコマンド ---
SUBCMD="${1:-director}"

# --- herdr 到達チェック / 自動起動（herdr モード時） ---
# start.sh と同じ判定を ./crewvia でも行う。
# server が落ちていれば起動してから crewvia を続行し、起動できなければ早期 exit する。
#
# mux を必要とするサブコマンドに限定する。help / status は plan.sh を読むだけなので、
# スクリプトや cron から `./crewvia status` を叩くだけで常駐 daemon が生えるのを避ける。
NEEDS_MUX=0
case "$SUBCMD" in
  director|orchestrator|start|worker) NEEDS_MUX=1 ;;
esac

if [[ "$NEEDS_MUX" == "1" ]] && [[ "${CREWVIA_MUX:-}" == "herdr" ]]; then
  if ! command -v herdr >/dev/null 2>&1; then
    echo "[crewvia] ERROR: CREWVIA_MUX=herdr が設定されていますが herdr バイナリが見つかりません。" >&2
    echo "          herdr をインストールするか CREWVIA_MUX=tmux に変更してください。" >&2
    exit 1
  fi
  HERDR_WAS_DOWN=0
  if ! python3 "${SCRIPT_DIR}/scripts/lib_mux.py" server-running >/dev/null 2>&1; then
    HERDR_WAS_DOWN=1
    echo "[crewvia] herdr server が起動していません。起動します..."
  fi
  # available() が未起動なら 'herdr server' を detached で起動し、最大 10 秒 ping を待つ。
  if ! python3 "${SCRIPT_DIR}/scripts/lib_mux.py" available >/dev/null 2>&1; then
    echo "[crewvia] ERROR: herdr server を起動できませんでした。" >&2
    echo "          手動で 'herdr server' を実行し、~/.config/herdr/herdr-server.log を確認してください。" >&2
    exit 1
  fi
  if [[ "$HERDR_WAS_DOWN" == "1" ]]; then
    echo "[crewvia] herdr server を起動しました。"
  fi
fi

case "$SUBCMD" in
  status)
    exec bash "${SCRIPT_DIR}/scripts/plan.sh" status "${@:2}"
    ;;
  worker)
    shift
    exec bash "${SCRIPT_DIR}/scripts/start.sh" worker "$@"
    ;;
  director|orchestrator|start)
    exec bash "${SCRIPT_DIR}/scripts/start.sh" director
    ;;
  help|-h|--help)
    cat <<HELP
crewvia — マルチエージェントシステム ランチャー

Usage:
  ./crewvia [--taskvia|--no-taskvia] [subcommand] [options]

Subcommands:
  (none)                            Director を起動 (デフォルト)
  worker <skill> ...                Worker を起動
  status [--mission slug]           ミッション状態を表示

Flags:
  --taskvia                         Taskvia 承認フローを有効化
  --no-taskvia                      Taskvia 連携を無効化（スタンドアロン）

Taskvia フラグ:
  --taskvia      承認フロー有効（WebUI でツール承認・ログ投稿）
  --no-taskvia   スタンドアロンモード（承認なし、トークン不要）
  ※ config/crewvia.yaml の taskvia: 設定より優先される

Config:  config/crewvia.yaml
Token:   config/.taskvia-token  (1行にトークンを書く、gitignore 済み)

Environment variables (config より優先):
  CREWVIA_TASKVIA=enabled|disabled|ask  Taskvia 連携モード（最優先）
  CREWVIA_MUX=tmux|herdr                mux バックエンド（config の mode: より優先）
  TASKVIA_TOKEN=sk-...                  API トークン
  TASKVIA_URL=https://...               Taskvia URL

  ※ CREWVIA_TMUX は廃止されました（無視されます）。CREWVIA_MUX を使用してください。

Behavior:
  tmux モード: kickoff + Dispatcher 起動後に Director 窓に attach します。
    tmux 内から起動した場合は switch-client、外からなら attach-session (exec) を使用します。
  herdr モード: 普通のターミナルから ./crewvia を実行してください。
    herdr server が起動していなければ ./crewvia が自動で起動し、その後 'herdr' へ exec します。
    herdr の pane 内から実行した場合は tab focus のみ（自動 attach なし）。
HELP
    ;;
  *)
    echo "[crewvia] Unknown command: $SUBCMD" >&2
    echo "  Run './crewvia help' for usage." >&2
    exit 1
    ;;
esac
