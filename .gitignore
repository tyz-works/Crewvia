# Environment variables
.env
.env.*
.env.local
.env.production

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Secrets
*.pem
*.key
*.p12
*.secret

# Crewvia runtime state (per-session)
# .crewvia-env: worktree ごとの一時状態 (CREWVIA_MISSION_SLUG/TASK_ID/TASK_SLUG)。
# plan.sh pull がタスクごとに書き換えるため、追跡下のままだと全 PR に無関係な
# diff が混入する (t007, PR#180)。追跡解除のみ (git rm --cached) — ファイル自体は
# 各 worktree に residual として残り、plan.sh はこれまで通り source される前提で動く。
.crewvia-env
queue/
registry/mux/
# Worker が起動された TARGET_DIR の記録 (t009)。実行時の状態で、コミットしない
registry/workers/
registry/heartbeats/
registry/activity/
registry/notifications/
registry/approvals/
registry/handoffs/
registry/retirements/
# 退役の直前の worktree の保存 (vNext 02 PR-G)。patch・untracked を含むのでコミットしない
registry/checkpoints/
registry/daemons/
# herdr-task-graph 連携の生成物。plan.sh の pull / done / update のたびに
# 書き換わるので、追跡下に置くと全 worktree と主 WT の git status が毎回汚れ、
# 以後すべての PR に混入する（.crewvia-env で同型の事故あり）。
registry/task-graph/
# PR の CI の見える化記録 (dispatcher が書く・消してよい。CLAUDE.md 不変条件 7)。
# 他の registry/* と同様、追跡下に置くと全 worktree と主 WT の git status が毎回汚れる
registry/ci/
registry/.workers.lock
registry/dispatcher.log
registry/dispatcher_all_done.flag
registry/watchdog.log
registry/watchdog-observations.jsonl
logs/

# Claude Code local state
.claude/settings.local.json
# .claude/ 配下の .bak を一般化 (t011)。t001 で .claude/settings.json.bak を
# ファイル名ピンポイントで追加したが、直後に .claude/settings.local.json.pre-automode.bak
# が untracked で現れ同じ取りこぼしが即座に再現した。人手のバックアップ・ツール/hook が
# 作る .bak のどちらも、ファイル名を問わず拾う一般パターンに統合する
# (末尾が .bak のものだけが対象。sh_perm_manager.sh の一時バックアップは
# *.bak.hook.$$ という別の命名のため対象外のままだが、通常終了時は自己削除される)
.claude/*.bak
.claude/scheduled_tasks.lock
# crewvia TARGET_DIR mode: Worker 専用 settings ファイル（start.sh が起動時に生成 / plan.sh done で削除）
# worktree 汚染防止のため gitignore 対象とする
.claude/crewvia-worker-*.json

# Crewvia secrets
config/.taskvia-token
registry/verification/

# Python
__pycache__/
*.pyc

# Benchmark fixture runtime git repo (created by bench/init-fixture.sh)
bench/fixture/.git/
# Bench Worker runtime settings (regenerated by benchmark-ctx.sh at runtime)
bench/fixture/.claude/

# Benchmark run result artifacts (contain machine-specific session_file absolute paths)
registry/benchmarks/**/*.json

# Worker per-task worktrees (gitignored, managed by scripts/git-helpers.sh)
.claude/worktrees/

# マシン固有の設定の上書き (git 管理外。設計: knowledge/machine-local-config.md)
config/crewvia.local.yaml
